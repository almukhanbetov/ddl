# Copy this file to .env on the VPS, next to docker-compose.prod.yml
# (i.e. at VPS_PATH), and fill in real values. Never commit the real .env.

DOCKERHUB_USERNAME=changeme

DB_USER=ddl
DB_PASSWORD=changeme-generate-a-strong-password
DB_NAME=ddl

# Comma-separated list of origins allowed to call the API with credentials.
# Path-based routing (nginx proxies /api and /uploads to the backend on the
# same domain as the frontend) means this is just the site's own origin.
CORS_ORIGINS=https://ddldecor.kz,https://www.ddldecor.kz

DELIVERY_COST=5000

# Generate with: openssl rand -hex 32
JWT_SECRET=changeme-generate-a-random-secret
